<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Self-contained, dependency-free GL module. Targets net10.0 to match the host
    (PMIMS) but has NO project references and NO NuGet dependencies beyond the
    BCL, so it can be dropped into any .NET solution unchanged. Config lives in
    /Config as data; the /Demo folder holds a runnable self-test (see below).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Ledger.Gl</RootNamespace>
    <!-- Build as a library by default; the Demo is compiled only when DEMO is set. -->
    <OutputType Condition="'$(DEMO)' == 'true'">Exe</OutputType>
    <StartupObject Condition="'$(DEMO)' == 'true'">Ledger.Gl.Demo.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <!-- Ship the example configuration next to the assembly for easy loading. -->
    <None Include="Config\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Exclude the demo from library builds; include only when DEMO=true. -->
  <ItemGroup Condition="'$(DEMO)' != 'true'">
    <Compile Remove="Demo\**\*.cs" />
  </ItemGroup>

</Project>
