{
  // ==========================================================================
  // EXAMPLE GL CONFIGURATION for a gold/silver precious-metals inventory system.
  // Drop this file next to the module and load it with GlConfiguration.FromFile.
  // Everything below is data -- change accounts or mappings here, never in code.
  //
  // How mapping works: each rule says, for an event type (+ optional commodity),
  // which accounts to Debit and which to Credit. The engine posts the event's
  // Amount to those accounts. Debit legs and Credit legs must each sum to the
  // full amount (amountFactor lets you split), so every entry is balanced.
  // ==========================================================================
  "baseCurrency": "KWD",

  "accounts": [
    // --- Assets -------------------------------------------------------------
    { "code": "1200", "name": "Inventory - Gold",            "type": "Asset" },
    { "code": "1210", "name": "Inventory - Silver",          "type": "Asset" },
    { "code": "1000", "name": "Cash / Bank - Clearing",      "type": "Asset" },
    { "code": "1100", "name": "Accounts Receivable",         "type": "Asset" },
    { "code": "1300", "name": "Cost of Goods Sold - Clearing","type": "Asset" },

    // --- Liabilities --------------------------------------------------------
    { "code": "2000", "name": "Accounts Payable - Vendors",  "type": "Liability" },
    // Customer-owned metal held in KFH custody is NOT KFH's asset -- it is an
    // obligation to return the customer's bars. Booked as a custody liability with
    // an offsetting off-balance-sheet contra asset so the two net to zero equity
    // impact while still being visible and auditable in the ledger.
    { "code": "2900", "name": "Customer Metal - Custody Obligation", "type": "Liability" },

    // --- Off-balance-sheet contra (memo) ------------------------------------
    { "code": "1900", "name": "Customer Metal - Custody (Contra Asset)", "type": "Asset" },

    // --- Revenue ------------------------------------------------------------
    { "code": "4000", "name": "Sales Revenue - Gold",        "type": "Revenue" },
    { "code": "4010", "name": "Sales Revenue - Silver",      "type": "Revenue" },

    // --- Expense ------------------------------------------------------------
    { "code": "5000", "name": "Cost of Goods Sold",          "type": "Expense" },
    { "code": "5900", "name": "Inventory Write-off / Shrinkage", "type": "Expense" },
    { "code": "5910", "name": "Inventory Adjustment (Loss)", "type": "Expense" },
    { "code": "4900", "name": "Inventory Adjustment (Gain)", "type": "Revenue" }
  ],

  "rules": [
    // === PURCHASE: acquire metal on credit ==================================
    // Dr Inventory (asset up)  /  Cr Accounts Payable (liability up)
    {
      "eventType": "Purchase", "commodity": "GOLD",
      "description": "Gold purchase received into vault, billed by vendor.",
      "legs": [
        { "account": "1200", "side": "Debit"  },
        { "account": "2000", "side": "Credit" }
      ]
    },
    {
      "eventType": "Purchase", "commodity": "SILVER",
      "description": "Silver purchase received into vault, billed by vendor.",
      "legs": [
        { "account": "1210", "side": "Debit"  },
        { "account": "2000", "side": "Credit" }
      ]
    },

    // === CUSTODY DEPOSIT: customer's own metal placed into KFH vault =======
    // Matched by "ownership": "CUSTOMER_OWNED" -- this rule is MORE SPECIFIC than
    // the plain gold/silver purchase rules above (a satisfied match condition
    // outranks an exact commodity), so a customer deposit books here instead of to
    // KFH inventory. Wildcard commodity => applies to gold and silver alike.
    // Dr Custody contra asset  /  Cr Custody obligation (net zero equity impact).
    {
      "eventType": "Purchase", "commodity": "*",
      "match": { "ownership": "CUSTOMER_OWNED" },
      "description": "Customer metal received into custody (not a KFH purchase).",
      "legs": [
        { "account": "1900", "side": "Debit"  },
        { "account": "2900", "side": "Credit" }
      ]
    },

    // === CUSTODY WITHDRAWAL: customer takes their own metal back ============
    // Reverses the custody obligation. Dr Custody obligation / Cr Custody contra.
    {
      "eventType": "Sale", "commodity": "*",
      "match": { "ownership": "CUSTOMER_OWNED" },
      "description": "Customer custody metal returned/withdrawn (not a KFH sale).",
      "legs": [
        { "account": "2900", "side": "Debit"  },
        { "account": "1900", "side": "Credit" }
      ]
    },

    // === SALE: sell metal on account =======================================
    // Amount here is the SALE (revenue) value.
    // Dr Accounts Receivable (asset up)  /  Cr Sales Revenue (revenue up)
    {
      "eventType": "Sale", "commodity": "GOLD",
      "description": "Gold sold to customer on account.",
      "legs": [
        { "account": "1100", "side": "Debit"  },
        { "account": "4000", "side": "Credit" }
      ]
    },
    {
      "eventType": "Sale", "commodity": "SILVER",
      "description": "Silver sold to customer on account.",
      "legs": [
        { "account": "1100", "side": "Debit"  },
        { "account": "4010", "side": "Credit" }
      ]
    },

    // === TRANSFER: move stock between locations ============================
    // Financially neutral within one legal entity, but we still record a
    // traceable zero-net contra pair against the inventory account so the
    // movement shows up in the ledger history. (Both legs same account = net 0.)
    {
      "eventType": "Transfer", "commodity": "GOLD",
      "description": "Gold moved between vault locations (GL-neutral).",
      "legs": [
        { "account": "1200", "side": "Debit"  },
        { "account": "1200", "side": "Credit" }
      ]
    },
    {
      "eventType": "Transfer", "commodity": "SILVER",
      "description": "Silver moved between vault locations (GL-neutral).",
      "legs": [
        { "account": "1210", "side": "Debit"  },
        { "account": "1210", "side": "Credit" }
      ]
    },

    // === WRITE-OFF: stock lost with no consideration =======================
    // Dr Write-off expense  /  Cr Inventory (asset down)
    {
      "eventType": "WriteOff", "commodity": "GOLD",
      "description": "Gold written off (loss/shrinkage).",
      "legs": [
        { "account": "5900", "side": "Debit"  },
        { "account": "1200", "side": "Credit" }
      ]
    },
    {
      "eventType": "WriteOff", "commodity": "SILVER",
      "description": "Silver written off (loss/shrinkage).",
      "legs": [
        { "account": "5900", "side": "Debit"  },
        { "account": "1210", "side": "Credit" }
      ]
    },

    // === ADJUSTMENT (downward): inventory valued down ======================
    // Wildcard commodity fallback -- applies to any commodity with no specific
    // adjustment rule. Dr Adjustment-loss expense / Cr generic inventory clearing.
    // For commodity-specific inventory accounts, add explicit rules like above.
    {
      "eventType": "Adjustment", "commodity": "GOLD",
      "description": "Gold inventory value adjusted down.",
      "legs": [
        { "account": "5910", "side": "Debit"  },
        { "account": "1200", "side": "Credit" }
      ]
    },
    {
      "eventType": "Adjustment", "commodity": "SILVER",
      "description": "Silver inventory value adjusted down.",
      "legs": [
        { "account": "5910", "side": "Debit"  },
        { "account": "1210", "side": "Credit" }
      ]
    }
  ]
}
