{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "DatabaseConfig": {
    "UseSqlServer": false,
    "SqlServerConnection": "Server=localhost;Database=KFH_PMIMS;Trusted_Connection=True;TrustServerCertificate=True;",
    "SqliteConnection": "Data Source=pmims.db"
  },
  "ActiveDirectory": {
    "Domain": "kfh.com.kw",
    "LdapServer": "ldap.kfh.com.kw"
  },
  "Jwt": {
    "Issuer": "KFH-PMIMS",
    "Audience": "KFH-PMIMS-Client",
    "ExpiryMinutes": 60,
    "_comment": "DEV ONLY key. In production load from a secret store / environment variable.",
    "Key": "dev-only-pmims-signing-key-change-me-32+chars-minimum-0123456789"
  },
  "Fim": {
    "_comment": "FIM Integration Module (PasswordHasher AES-256 option). DEV ONLY key -- load from a secret store / environment variable before any real deployment. Not needed for the BCRYPT default.",
    "AesKey": "dev-only-pmims-fim-aes256-key-change-me-32b!!",
    "SyncBatchSize": 500,
    "DeltaSyncEnabled": true
  }
}
