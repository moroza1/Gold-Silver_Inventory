<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.8" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.8" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Serilog" Version="3.1.1" />
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PMIMS.Application\PMIMS.Application.csproj" />
    <ProjectReference Include="..\PMIMS.Infrastructure\PMIMS.Infrastructure.csproj" />
    <!-- Plug-and-play General Ledger module + its EF Core persistence adapter. -->
    <ProjectReference Include="..\Ledger.Gl.EfCore\Ledger.Gl.EfCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ship the GL configuration (chart of accounts + posting rules) with the app. -->
    <None Include="..\Ledger.Gl\Config\gl-accounts.gold-silver.json"
          Link="Config\gl-accounts.gold-silver.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
